---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, isoDate } from '../../utils/date';
import { isFormOpen } from '../../config';

export async function getStaticPaths() {
  const articles = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return articles.map((article, i) => ({
    params: { slug: article.id },
    props: {
      article,
      newer: articles[i - 1],
      older: articles[i + 1],
      related: articles.filter((a) => a.id !== article.id).slice(0, 4),
    },
  }));
}

const { article, newer, older, related } = Astro.props;
const { Content } = await render(article);
// 受付前は「相談してください」と促さない（相談フォームは公開準備中）。受付開始は PUBLIC_FORM_OPEN=1（利用者の判断）
const formReady = isFormOpen(import.meta.env.PUBLIC_FORM_KEY || '', import.meta.env.PUBLIC_FORM_OPEN);
---
<Layout title={article.data.title} description={article.data.summary} crumbs={[{ label: 'お知らせ・読み物', href: '/news' }, { label: article.data.title }]}>
  <div>
    <article class="max-w-3xl mx-auto px-4 py-14 md:py-20">

      <header class="mb-10">
        <div class="flex items-center gap-3 mb-3">
          <a href="/news" class="bg-deep text-white text-sm font-bold tracking-wider px-3 py-0.5 rounded-full">{article.data.category}</a>
          <time datetime={isoDate(article.data.date)} class="text-[1rem] text-ink-muted">{formatDate(article.data.date)}</time>
        </div>
        <h1 class="font-heading text-2xl md:text-4xl font-bold text-ink-strong leading-snug">{article.data.title}</h1>
      </header>

      <div class="article-body">
        <Content />
      </div>

      <!-- 読み終えた先に、相談とサービスの案内を置く -->
      <div class="cta-panel mt-14" data-testid="article-cta">
        {formReady ? (
          <>
            <p class="font-heading font-bold text-ink-strong text-lg mb-4">付き添いについて、お気軽にご相談ください</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
              <a href="/contact" class="btn-solid min-h-[52px] px-4 sm:px-11 tracking-[0.04em]">付き添いについて相談する</a>
              <a href="/service" class="btn-outline">サービス・料金を見る</a>
            </div>
          </>
        ) : (
          <>
            <p class="font-heading font-bold text-ink-strong text-lg mb-2">ご相談の受付は準備中です</p>
            <p class="text-[1rem] text-ink-muted mb-4 [word-break:auto-phrase]">受付を始めるまで、サービスと料金をご覧ください。</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
              <a href="/service" class="btn-solid min-h-[52px] px-4 sm:px-11 tracking-[0.04em]">サービス・料金を見る</a>
              <a href="/contact" class="btn-outline">受付の状況を見る</a>
            </div>
          </>
        )}
      </div>

      <!-- Prev / Next -->
      <nav aria-label="前後の記事" class="mt-16 border-t border-rule pt-8 grid sm:grid-cols-2 gap-4 text-[1rem]">
        <div>
          {newer && (
            <a href={`/news/${newer.id}`} class="block hover:text-accent">
              <span class="block text-sm text-ink-muted">← 新しい記事</span>
              {newer.data.title}
            </a>
          )}
        </div>
        <div class="sm:text-right">
          {older && (
            <a href={`/news/${older.id}`} class="block hover:text-accent">
              <span class="block text-sm text-ink-muted">古い記事 →</span>
              {older.data.title}
            </a>
          )}
        </div>
      </nav>

      <!-- Related -->
      {related.length > 0 && (
        <section class="mt-16" aria-labelledby="related-heading">
          <h2 id="related-heading" class="font-heading text-xl font-bold text-ink-strong mb-4">ほかの記事</h2>
          <ul class="space-y-3">
            {related.map((r) => (
              <li>
                <a href={`/news/${r.id}`} class="block border border-rule p-4 hover:border-accent">
                  <time datetime={isoDate(r.data.date)} class="text-sm text-ink-muted">{formatDate(r.data.date)}</time>
                  <span class="block font-bold text-ink-strong">{r.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="text-center mt-16">
        <a href="/news" class="btn-outline">
          一覧に戻る
        </a>
      </div>
    </article>
  </div>
</Layout>
