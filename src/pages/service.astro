---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { SITE } from '../config';

// 金額はすべて税込。参考サイトの価格帯に合わせた初期値。独自の価格設定にする際はここだけ書き換える。
// 公開できるのは、許可・登録が不要な「付き添い」の料金だけ（CLAUDE.md 1.）。
const prices = [
  {
    head: '1時間のご利用料金',
    lines: [{ label: '', price: '3,300円（税込）〜' }],
    note: '半日や1日のご利用には割引を用意します（詳細は準備中）。',
  },
  {
    head: '国内・宿泊旅行の付き添い　基本料金',
    lines: [{ label: '1泊2日', price: '49,500円（税込）〜' }],
    note: '付き添いの料金です。交通・宿泊の手配は含みません。',
  },
  {
    head: '海外旅行の付き添い　基本料金',
    lines: [{ label: '1日あたり', price: '33,000円（税込）〜' }],
    note: '付き添いの料金です。交通・宿泊の手配は含みません。',
  },
];

// 許可・登録の確認が済むまで、料金は載せず「準備中」とだけ案内する。確認できたら prices に移す。
// 公開時に揃える価格帯の目安: 福祉タクシー 初乗り(30分) 3,550円・加算(15分ごと) 1,770円
const upcoming = [
  { head: '福祉タクシー（利用条件あり）', text: '必要な許可などの確認が済み次第、料金とあわせてご案内します。' },
  { head: '旅行の手配について', text: '交通・宿泊の予約などの手配は、旅行の付き添いとは別のメニューです。必要な登録などの確認が済み次第ご案内します。' },
];

const flow = [
  { title: 'ご相談', text: 'まずはフォームかお電話でご連絡ください。行き先や日時、手伝ってほしいことを伺います。', note: 'お会いしての事前打ち合わせには、別途料金がかかります。' },
  { title: 'お見積り', text: '伺った内容から費用をお出しします。金額にご了承いただいてから、日程を確定します。', note: '' },
  { title: '当日', text: 'お約束した日時に、打ち合わせた内容に沿ってスタッフが付き添います。', note: 'お支払いを後日にしたい方は、ご依頼の前にお知らせください。' },
];

const examples = ['通院', 'お買い物', '外食', '日帰りのお出かけ', '旅行への付き添い', '結婚式', 'お引越し'];
---
<Layout title="サービス" description={`${SITE.SERVICE_NAME}のサービス内容、料金、ご利用の流れのご案内です。`} crumbs={[{ label: 'サービス' }]}>
  <div class="max-w-3xl mx-auto px-4 py-14 md:py-20">
    <h1 class="sr-only">サービス</h1>

    <!-- Flow -->
    <h2 class="font-heading text-xl md:text-2xl font-bold text-center border-[3px] border-base-alt outline outline-1 outline-rule py-5 mb-12 tracking-[0.12em]">ご利用の流れ</h2>
    <ol class="mb-16">
      {flow.map((f, i) => (
        <li class="step">
          <span class="step-badge" aria-hidden="true"><small>STEP</small><b>{i + 1}</b></span>
          <h3 class="font-heading text-lg font-bold pt-2 mb-3 text-ink-strong">{f.title}</h3>
          <p class="text-[15px] leading-loose [word-break:auto-phrase]">{f.text}</p>
          {f.note && <p class="text-[15px] leading-loose [word-break:auto-phrase]">※{f.note}</p>}
        </li>
      ))}
    </ol>

    <!-- Price -->
    <SectionTitle class="mb-10">基本料金</SectionTitle>
    <div class="mb-16" data-testid="price-list">
      {prices.map((p) => (
        <section>
          <h3 class="price-head text-[15px]">▼ {p.head}</h3>
          <div class="price-body">
            {p.lines.map((l) => (
              <p class="font-bold text-ink-strong">{l.label && <span class="mr-3">{l.label}</span>}{l.price}</p>
            ))}
            <p class="text-sm text-ink-muted mt-1">※{p.note}</p>
          </div>
        </section>
      ))}

      <div data-testid="upcoming-menu">
        {upcoming.map((u) => (
          <section>
            <h3 class="price-head text-[15px]">▼ {u.head}</h3>
            <div class="price-body flex flex-col sm:flex-row sm:items-center gap-3">
              <p class="grow text-[15px] leading-loose [word-break:auto-phrase]">{u.text}</p>
              <span class="shrink-0 self-start border border-rule bg-base-alt text-ink-muted font-bold text-sm px-4 py-1 rounded-full">準備中</span>
            </div>
          </section>
        ))}
      </div>
      <p class="text-sm text-ink-muted mt-3">表示はすべて税込です。</p>
    </div>

    <!-- Examples -->
    <SectionTitle class="mb-8">ご利用例</SectionTitle>
    <ul class="flex flex-wrap gap-3 mb-16">
      {examples.map((e) => <li class="chip">{e}</li>)}
    </ul>

    <div class="text-center">
      <a href="/contact" class="btn-solid">お問い合わせはこちら</a>
    </div>
  </div>
</Layout>
