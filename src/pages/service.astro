---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { SITE } from '../config';
import { prices } from '../utils/prices';
import { getCasesByGenre } from '../utils/cases';

// 許可・登録の確認が済むまで、料金は載せず「準備中」とだけ案内する。確認できたら prices に移す。
// 公開時に揃える価格帯の目安: 福祉タクシー 初乗り(30分) 3,550円・加算(15分ごと) 1,770円
const upcoming = [
  { head: '福祉タクシー（利用条件あり）', text: '必要な許可などの確認が済み次第、料金とあわせてご案内します。' },
  { head: '旅行の手配について', text: '交通・宿泊の予約などの手配は、旅行の付き添いとは別のメニューです。必要な登録などの確認が済み次第ご案内します。' },
];

const flow = [
  { title: 'ご相談', text: 'まずはフォームかお電話でご連絡ください。行き先や日時、手伝ってほしいことを伺います。', note: 'お会いしての事前打ち合わせの料金は、準備中です。' },
  { title: 'お見積り', text: '伺った内容から費用をお出しします。金額にご了承いただいてから、日程を確定します。', note: '' },
  { title: '当日', text: 'お約束した日時に、打ち合わせた内容に沿ってスタッフが付き添います。', note: 'お支払いを後日にしたい方は、ご依頼の前にお知らせください。' },
];

// 相談のときに伺うこと（既存の「ご相談」「お見積り」の文面を整理したもの）
const checks = [
  { head: '行き先', text: '病院やお店など。日にちがまだ決まっていなくても大丈夫です。' },
  { head: '日時', text: 'おおよその時間帯が分かれば、お知らせください。' },
  { head: '必要なお手伝い', text: '歩き方や体調のこと、不安に思うことなど、分かる範囲で構いません。' },
  { head: '費用の見積り', text: '伺った内容から費用をお出しします。ご了承いただいてから日程を確定します。' },
];

// 内容が確定するまで、断定せず「準備中」とする（対応範囲・追加費用の条件・家族への共有方法・医療的ケア）
const pendingScope = [
  '対応できる範囲のくわしい内容',
  '上に載せた料金のほかに、費用がかかる場合の条件',
  'ご家族への共有の具体的な方法（連絡の手段・頻度など）',
  '医療的なケアについて',
];

const caseGroups = await getCasesByGenre();
---
<Layout title="サービス・料金" description={`${SITE.SERVICE_NAME}のサービス内容、料金、ご利用の流れのご案内です。`} crumbs={[{ label: 'サービス・料金' }]}>
  <div class="max-w-3xl mx-auto px-4 py-14 md:py-20">
    <h1 class="sr-only">サービス・料金</h1>

    <!-- このページの内容（ページ内リンク） -->
    <nav aria-label="このページの内容" class="mb-12" data-testid="service-toc">
      <ul class="flex flex-col sm:flex-row sm:flex-wrap sm:justify-center gap-3">
        <li><a href="#flow" class="btn-outline w-full sm:w-auto">ご利用の流れ</a></li>
        <li><a href="#prices" class="btn-outline w-full sm:w-auto">基本料金</a></li>
        <li><a href="#examples" class="btn-outline w-full sm:w-auto">ご利用例</a></li>
      </ul>
    </nav>

    <!-- Flow -->
    <div id="flow" class="scroll-mt-24"></div>
    <h2 class="font-heading text-xl md:text-2xl font-bold text-center border-[3px] border-base-alt outline outline-1 outline-rule py-5 mb-12 tracking-[0.12em]">ご利用の流れ</h2>
    <ol class="mb-16">
      {flow.map((f, i) => (
        <li class="step">
          <span class="step-badge" aria-hidden="true"><small>STEP</small><b>{i + 1}</b></span>
          <h3 class="font-heading text-lg font-bold pt-2 mb-3 text-ink-strong">{f.title}</h3>
          <p class="text-[17px] leading-loose [word-break:auto-phrase]">{f.text}</p>
          {f.note && <p class="text-[17px] leading-loose [word-break:auto-phrase]">※{f.note}</p>}
        </li>
      ))}
    </ol>

    <div class="mb-16 bg-base-alt border-l-4 border-accent px-5 py-5" data-testid="consult-checklist">
      <h3 class="font-heading font-bold text-ink-strong text-lg mb-3">ご相談のときに伺うこと</h3>
      <ul class="space-y-2">
        {checks.map((c) => (
          <li class="text-[17px] leading-loose [word-break:auto-phrase]"><b class="text-ink-strong mr-2">{c.head}</b>{c.text}</li>
        ))}
      </ul>
    </div>

    <!-- Price -->
    <div id="prices" class="scroll-mt-24"></div>
    <SectionTitle class="mb-10">基本料金</SectionTitle>
    <div class="mb-16" data-testid="price-list">
      {prices.map((p) => (
        <section>
          <h3 class="price-head text-[17px]">▼ {p.head}</h3>
          <div class="price-body">
            {p.lines.map((l) => (
              <p class="font-bold text-ink-strong">{l.label && <span class="mr-3">{l.label}</span>}{l.price}</p>
            ))}
            <p class="text-[1rem] text-ink-muted mt-1">※{p.note}</p>
          </div>
        </section>
      ))}

      <div data-testid="upcoming-menu">
        {upcoming.map((u) => (
          <section>
            <h3 class="price-head text-[17px]">▼ {u.head}</h3>
            <div class="price-body flex flex-col sm:flex-row sm:items-center gap-3">
              <p class="grow text-[17px] leading-loose [word-break:auto-phrase]">{u.text}</p>
              <span class="shrink-0 self-start border border-rule bg-base-alt text-ink-muted font-bold text-[1rem] px-4 py-1 rounded-full">準備中</span>
            </div>
          </section>
        ))}
      </div>
      <p class="text-[1rem] text-ink-muted mt-3">表示はすべて税込です。</p>
      <p class="text-[1rem] text-ink-muted mt-1 [word-break:auto-phrase]" data-testid="estimate-note">実際の金額は、ご相談のあとのお見積りでお知らせします。ご了承いただいてから日程を確定します。</p>
      <div class="text-center mt-10" data-testid="price-cta">
        <p class="mb-4 text-[17px] [word-break:auto-phrase]">料金や内容について、まずはお気軽にご相談ください。</p>
        <a href="/contact" class="btn-solid min-h-[52px]">相談フォームへ</a>
      </div>
    </div>

    <!-- 準備中の項目（断定しない） -->
    <section class="mb-16 border border-rule px-5 py-6" data-testid="pending-scope" aria-labelledby="pending-scope-title">
      <h2 id="pending-scope-title" class="font-heading font-bold text-ink-strong text-lg mb-3">くわしい内容は準備中です</h2>
      <p class="text-[17px] leading-loose mb-3 [word-break:auto-phrase]">次の内容は、まだ準備を進めています。確定するまでは、ご相談のときに個別にお伝えします。</p>
      <ul class="list-disc pl-6 space-y-1 text-[17px] leading-loose">
        {pendingScope.map((t) => <li>{t}</li>)}
      </ul>
    </section>

    <!-- Examples -->
    <div id="examples" class="scroll-mt-24"></div>
    <SectionTitle class="mb-4">ご利用例</SectionTitle>
    <p class="text-[1rem] text-ink-muted mb-6">気になる場面を選ぶと、写真とくわしい内容が見られます（想定の場面です）。</p>
    <div class="mb-8 space-y-5" data-testid="case-groups">
      {caseGroups.map((g) => (
        <div>
          <p class="font-heading font-bold text-ink-strong mb-2">{g.genre}</p>
          <ul class="flex flex-wrap gap-3">
            {g.cases.map((c) => <li><a href={`/cases/${c.id}`} class="chip">{c.data.title}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="mb-12"><a href="/cases" class="btn-outline">ご利用例をすべて見る</a></p>

    <div class="text-center">
      <a href="/contact" class="btn-solid min-h-[52px]">相談フォームへ</a>
    </div>
  </div>
</Layout>
