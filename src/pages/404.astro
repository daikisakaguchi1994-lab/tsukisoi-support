---
import Layout from '../layouts/Layout.astro';
---
<Layout title="ページが見つかりません" crumbs={[{ label: 'ページが見つかりません' }]}>
  <div class="max-w-2xl mx-auto px-4 py-20 md:py-28 text-center">
    <p class="font-heading text-7xl font-bold text-rule mb-4" aria-hidden="true">404</p>
    <h1 class="heading-bar text-xl md:text-2xl mb-8">ページが見つかりません</h1>
    <p class="mb-10 leading-loose">お探しのページは移動または削除された可能性があります。</p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a href="/" class="btn-solid">トップページに戻る</a>
      <a href="/service" class="btn-outline">サービス・料金を見る</a>
    </div>
  </div>
</Layout>
