---
import Layout from '../layouts/Layout.astro';
import PageTitle from '../components/PageTitle.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { SITE, isConfigured } from '../config';

// カテゴリごとに並べる。href が未設定のものは画面に出さず、カテゴリごと「準備中」にする。
const categories = [
  {
    title: '公式の窓口',
    links: [
      { label: 'LINE公式アカウント', description: 'ご相談・ご予約の連絡にお使いいただけます。', href: SITE.LINE_URL },
      { label: 'Instagram', description: 'お出かけの様子やお知らせをお届けします。', href: SITE.INSTAGRAM_URL },
    ].filter((l) => isConfigured(l.href)),
  },
  {
    title: '連携・協力いただいている団体',
    // 確認が取れた団体だけを、承諾を得てから追加する
    links: [] as { label: string; description: string; href: string }[],
  },
];
---
<Layout title="関連リンク" description={`${SITE.SERVICE_NAME}の公式アカウントや関連団体へのリンクです。`} crumbs={[{ label: '関連リンク' }]}>
  <div class="max-w-3xl mx-auto px-4 py-14 md:py-20">
    <PageTitle class="mb-14">関連リンク</PageTitle>

    <div class="space-y-14">
      {categories.map((c) => (
        <section>
          <SectionTitle class="is-left mb-6">{c.title}</SectionTitle>
          {c.links.length > 0 ? (
            <ul class="space-y-3">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class="block border border-rule p-5 hover:border-accent">
                    <span class="block font-heading font-bold text-accent">{l.label}</span>
                    <span class="block text-sm mt-1">{l.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-ink-muted">準備中です</p>
          )}
        </section>
      ))}
    </div>
  </div>
</Layout>
