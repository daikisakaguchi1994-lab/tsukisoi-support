---
import Layout from '../layouts/Layout.astro';
import PageTitle from '../components/PageTitle.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { SITE } from '../config';

// 代表者の氏名・資格・経歴は未確定。確定した内容をここに入れると、「準備中」の表示が自動で消える。
const profile = {
  name: '',
  qualifications: [] as string[],
  career: [] as string[],
};
const hasProfile = Boolean(profile.name);

const policies = [
  { title: 'ご本人のペースを大切に', text: '急がせず、できることはご本人にお任せし、必要なところだけをお手伝いします。' },
  { title: '「大丈夫」を一緒に確かめる', text: '段差や待ち時間など、不安に思うことを出かける前に一緒に確認します。' },
  { title: 'ご家族にも安心を', text: 'ご家族の不安にも耳を傾けます。当日の様子の共有のしかたは、準備中です。' },
];
---
<Layout title="私たちについて" description={`${SITE.SERVICE_NAME}の考え方と、代表者のご紹介です。`} crumbs={[{ label: '私たちについて' }]}>
  <div class="max-w-3xl mx-auto px-4 py-14 md:py-20">
    <PageTitle class="mb-12">私たちについて</PageTitle>
    <p class="text-center leading-loose mb-14 text-[17px] [word-break:auto-phrase]">
      {SITE.SERVICE_NAME}が大切にしていることと、代表者のご紹介です。
    </p>

    <!-- Policy -->
    <div id="policy" class="scroll-mt-24"></div>
    <SectionTitle class="mb-8">大切にしていること</SectionTitle>
    <ul class="grid md:grid-cols-3 gap-6 mb-16">
      {policies.map((p) => (
        <li class="border border-rule p-5">
          <h3 class="font-heading font-bold text-ink-strong mb-2 text-[17px]"><span class="marker">{p.title}</span></h3>
          <p class="text-[1rem] leading-loose">{p.text}</p>
        </li>
      ))}
    </ul>

    <!-- Profile -->
    <SectionTitle class="mb-8">代表者のご紹介</SectionTitle>
    {hasProfile ? (
    <>
    <div class="flex flex-col items-center text-center mb-10">
      <div class="w-40 h-52 bg-base-alt border border-rule flex items-center justify-center text-ink-muted text-[1rem] mb-4" role="img" aria-label="写真は準備中です">
        写真 準備中
      </div>
      <p class="font-heading text-lg font-bold text-ink-strong">{profile.name}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-4">
      <div>
        <h3 class="title-line is-left font-heading font-bold text-ink-strong mb-4">保有資格</h3>
        {profile.qualifications.length > 0 ? (
          <ul class="list-disc pl-6 text-[17px]">{profile.qualifications.map((q) => <li>{q}</li>)}</ul>
        ) : (
          <p class="text-[1rem] text-ink-muted">準備中です</p>
        )}
      </div>
      <div>
        <h3 class="title-line is-left font-heading font-bold text-ink-strong mb-4">経験・経歴</h3>
        {profile.career.length > 0 ? (
          <ul class="list-disc pl-6 text-[17px]">{profile.career.map((c) => <li>{c}</li>)}</ul>
        ) : (
          <p class="text-[1rem] text-ink-muted">準備中です</p>
        )}
      </div>
    </div>
    </>
    ) : (
      <p class="text-center text-[17px] leading-loose text-ink-muted [word-break:auto-phrase] mb-4" data-testid="profile-pending">お名前・写真・保有資格・経験は、準備中です。</p>
    )}
  </div>
  <ContactBlock />
</Layout>
