---
import Layout from '../layouts/Layout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';
import { SITE, isConfigured } from '../config';
import { formatDate, isoDate } from '../utils/date';

// 以下の文面は仮のコピーです。サービス内容が確定したら差し替えてください。
const services = [
  { icon: '🏥', title: '通院の付き添い', text: '受付から診察、会計、お薬の受け取りまで、院内でもそばに寄り添います。' },
  { icon: '🛍️', title: 'お買い物・外食', text: '歩くのが不安な方も、荷物の持ち運びや移動のお手伝いで、気兼ねなくお出かけいただけます。' },
  { icon: '🧳', title: '旅行・観光への付き添い', text: '駅や空港での移動など、旅の道中に付き添います。交通・宿泊の予約などの手配は準備中です。' },
  { icon: '🌸', title: '行事・お墓参り', text: '冠婚葬祭やお墓参りなど、大切な場面への外出もお手伝いします。' },
  { icon: '👨‍👩‍👧', title: 'ご家族への報告', text: '当日の様子をご家族にお伝えします。離れて暮らす方も安心です。' },
  { icon: '💬', title: 'まずはご相談を', text: 'こんなこともできる？というお悩みも、お気軽にお問い合わせください。' },
];

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const links = [
  { label: 'Instagram', href: SITE.INSTAGRAM_URL },
  { label: 'LINE公式アカウント', href: SITE.LINE_URL },
].filter((l) => isConfigured(l.href));
---
<Layout title="トップ">
  <Hero />

  <!-- Concept -->
  <section id="concept" class="py-20 md:py-28 fade-in scroll-mt-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="font-heading text-accent tracking-[0.3em] text-sm mb-3">CONCEPT</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-ink-strong mb-8">
        行きたい気持ちに、付き添います。
      </h2>
      <p class="leading-loose [word-break:auto-phrase]">
        {SITE.SERVICE_NAME}は、お出かけに付き添うサービスです。<br />
        年齢や体調、お住まいに関わらず、<br class="hidden md:inline" />
        「ひとりでは心配」を「一緒なら大丈夫」に変えていきます。
      </p>
    </div>
  </section>

  <!-- Service -->
  <section id="service" class="bg-base-alt py-20 md:py-28 fade-in scroll-mt-16">
    <div class="max-w-5xl mx-auto px-4">
      <p class="font-heading text-accent tracking-[0.3em] text-sm text-center mb-3">SERVICE</p>
      <SectionTitle class="mb-12">{SITE.SERVICE_NAME}のサービス</SectionTitle>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        {services.map((s) => (
          <div class="bg-white rounded-2xl shadow-sm p-8 text-center">
            <div class="text-4xl mb-4" aria-hidden="true">{s.icon}</div>
            <h3 class="font-heading font-bold text-lg text-ink-strong mb-2">{s.title}</h3>
            <p class="text-sm leading-relaxed">{s.text}</p>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="/service" class="inline-block bg-accent text-white font-bold px-8 py-3 rounded-full hover:bg-accent-hover transition-colors min-h-[44px]">
          料金・ご利用の流れを見る
        </a>
      </div>
    </div>
  </section>

  <!-- News -->
  <section id="news" class="py-20 md:py-28 fade-in scroll-mt-16">
    <div class="max-w-3xl mx-auto px-4">
      <p class="font-heading text-accent tracking-[0.3em] text-sm text-center mb-3">NEWS</p>
      <SectionTitle class="mb-10">お知らせ</SectionTitle>
      <ul class="space-y-4">
        {news.map((n) => (
          <li class="flex gap-4 items-baseline border-b border-ink/10 pb-4">
            <time datetime={isoDate(n.data.date)} class="text-sm text-ink-muted shrink-0">{formatDate(n.data.date)}</time>
            <a href={`/news/${n.id}`} class="hover:text-accent underline-offset-4 hover:underline">{n.data.title}</a>
          </li>
        ))}
      </ul>
      <div class="text-center mt-8">
        <a href="/news" class="inline-block border-2 border-accent text-accent font-bold px-8 py-3 rounded-full hover:bg-accent hover:text-white transition-colors min-h-[44px]">
          お知らせ・読み物の一覧へ
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="bg-base-alt py-20 md:py-28 fade-in scroll-mt-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="font-heading text-accent tracking-[0.3em] text-sm mb-3">ABOUT</p>
      <SectionTitle class="mb-8">私たちについて</SectionTitle>
      <p class="leading-loose mb-8 [word-break:auto-phrase]">
        {SITE.SERVICE_NAME}が大切にしていることと、代表者のご紹介です。<br />
        代表者の紹介は準備中です。
      </p>
      <a href="/about" class="inline-block border-2 border-accent text-accent font-bold px-8 py-3 rounded-full hover:bg-accent hover:text-white transition-colors min-h-[44px]">
        私たちについて
      </a>
    </div>
  </section>

  <!-- Links -->
  <section id="links" class="py-20 md:py-28 fade-in scroll-mt-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="font-heading text-accent tracking-[0.3em] text-sm mb-3">LINKS</p>
      <SectionTitle class="mb-8">関連リンク</SectionTitle>
      {links.length > 0 ? (
        <ul class="flex flex-wrap justify-center gap-4">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-block border-2 border-accent text-accent font-bold px-6 py-3 rounded-full hover:bg-accent hover:text-white transition-colors min-h-[44px]">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ink-muted">準備中です</p>
      )}
      <div class="mt-8">
        <a href="/links" class="text-accent underline underline-offset-4 hover:text-accent-hover">関連リンクのページへ</a>
      </div>
    </div>
  </section>

  <ContactBlock />
</Layout>
