---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import SectionTitle from '../components/SectionTitle.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import Wave from '../components/Wave.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { formatDate, isoDate } from '../utils/date';

// 以下の文面は仮のコピーです。サービス内容が確定したら差し替えてください。
// 経歴・資格・保有車両・対応言語など、事実の確認が必要なことは書かない（CLAUDE.md 1.）。
const features = [
  { icon: 'pace', label: 'ご本人のペースを大切に' },
  { icon: 'steps', label: '段差や待ち時間を事前に確認' },
  { icon: 'family', label: 'ご家族にも当日の様子を共有' },
  { icon: 'trip', label: '通院から旅行まで幅広く' },
  { icon: 'estimate', label: '見積りは事前に、納得してから' },
  { icon: 'form', label: 'ご相談はフォームから24時間' },
] as const;

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

// public/images/logo-mark.png があれば、導入部の大きなロゴに使う（無い間は文字のロゴ）
const logoMark = ['/images/logo-mark.png', '/images/logo-mark.svg'].find((f) => existsSync(join(process.cwd(), 'public', f)));
---
<Layout title="トップ" overlay>
  <Hero />

  <!-- Intro -->
  <section id="intro" class="scroll-mt-4 pt-16 pb-14">
    <div class="max-w-4xl mx-auto px-4">
      <div class="grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-8 md:gap-12 items-center mb-10">
        <div class="flex justify-center">
          {logoMark
            ? <img src={logoMark} alt={SITE.SERVICE_NAME} class="w-56 md:w-64 h-auto" />
            : (
              <div class="w-56 h-56 md:w-64 md:h-64 border border-rule flex flex-col items-center justify-center text-center" role="img" aria-label={`${SITE.SERVICE_NAME} ロゴ`}>
                <span class="font-heading text-xl md:text-2xl font-bold tracking-[0.18em] pl-[0.18em] whitespace-nowrap text-ink-strong">{SITE.SERVICE_NAME}</span>
                <span class="block w-10 h-px bg-accent my-3"></span>
                <span class="text-[10px] tracking-[0.4em] pl-[0.4em] text-ink-muted">TSUKISOI SUPPORT</span>
              </div>
            )}
        </div>
        <div class="leading-loose text-[15px] [word-break:auto-phrase] space-y-4">
          <p>{SITE.SERVICE_NAME}は、お出かけに付き添うサービスです。通院やお買い物、旅行まで、ひとりでは不安な外出にスタッフが寄り添います。</p>
          <p>年齢や体調、お住まいに関わらず、まずはお話をお聞かせください。ご希望を伺ったうえで、できることを一緒に考えます。</p>
        </div>
      </div>

      <div class="bg-base-alt border-l-4 border-accent px-5 py-4 text-sm leading-loose">
        <p class="font-bold mb-1"><span class="marker">付き添い（つきそい）</span>とは？</p>
        <p>行き先まで同行し、移動や手続きをそばで手伝うことです。ひとりで出かけるのが心細いとき、安心して外出できるようお手伝いします。</p>
      </div>
    </div>
  </section>

  <!-- News -->
  <Wave />
  <section id="news" class="bg-mist -my-px pb-12 pt-4 scroll-mt-4">
    <div class="max-w-3xl mx-auto px-4">
      <SectionTitle class="mb-6">最新のお知らせ</SectionTitle>
      <ul>
        {news.map((n) => (
          <li class="border-b border-rule/80">
            <a href={`/news/${n.id}`} class="block py-3 hover:text-accent">
              <span class="block text-[15px]">{n.data.title}</span>
              <time datetime={isoDate(n.data.date)} class="block text-xs text-ink-muted">{formatDate(n.data.date)}</time>
            </a>
          </li>
        ))}
      </ul>
      <div class="text-center mt-8">
        <a href="/news" class="btn-outline">お知らせ一覧を見る</a>
      </div>
    </div>
  </section>
  <Wave flip />

  <!-- Features -->
  <section id="features" class="py-14 scroll-mt-4">
    <div class="max-w-3xl mx-auto px-4">
      <SectionTitle variant="bar" class="mb-12">{SITE.SERVICE_NAME}の6つの特徴</SectionTitle>
      <ol class="grid grid-cols-2 md:grid-cols-3 gap-x-4 gap-y-10 mb-10">
        {features.map((f, i) => (
          <li class="text-center">
            <FeatureIcon name={f.icon} />
            <p class="mt-4 text-sm md:text-[15px] leading-snug [word-break:auto-phrase]">
              <span class="marker"><span aria-hidden="true">{i + 1} </span>{f.label}</span>
            </p>
          </li>
        ))}
      </ol>
      <div class="text-center">
        <a href="/service" class="btn-outline">サービスの詳細を見る</a>
      </div>
    </div>
  </section>

  <!-- Travel arrangement (preparing) -->
  <section id="travel" class="pb-16 scroll-mt-4">
    <div class="max-w-3xl mx-auto px-4">
      <SectionTitle variant="bar" class="mb-8">旅行の手配について</SectionTitle>
      <p class="leading-loose text-[15px] mb-6 [word-break:auto-phrase]">
        旅行の付き添いとは別に、交通・宿泊の予約などの手配も検討しています。必要な登録などの確認が済み次第、こちらでご案内します。
      </p>
      <div class="text-center">
        <span class="btn-outline" aria-disabled="true">準備中</span>
      </div>
    </div>
  </section>

  <ContactBlock />
</Layout>
