---
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/PageTitle.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import CaseCard from '../../components/CaseCard.astro';
import { SITE } from '../../config';
import { getCasesByGenre, genreId } from '../../utils/cases';

const groups = await getCasesByGenre();
const total = groups.reduce((n, g) => n + g.cases.length, 0);
---
<Layout title="ご利用例" description={`${SITE.SERVICE_NAME}のご利用例。通院、お買い物、旅行、暮らしの節目まで、どんな場面でご利用いただけるかをご紹介します。`} crumbs={[{ label: 'ご利用例' }]}>
  <div class="max-w-4xl mx-auto px-4 py-14 md:py-20">
    <PageTitle class="mb-8">ご利用例</PageTitle>

    <p class="max-w-2xl mx-auto leading-loose text-center [word-break:auto-phrase] mb-3">
      どんな場面で付き添いを頼めるのか、イメージしていただけるように、{total}つの場面をご紹介します。気になる場面を選んでください。
    </p>
    <p class="max-w-2xl mx-auto text-[1rem] text-ink-muted text-center [word-break:auto-phrase] mb-10" data-testid="case-disclaimer">
      ※ここでご紹介するのは「こんなときにご利用いただけます」という想定の場面です。実際のお客様の事例ではありません。写真は生成AIによるイメージで、手を添えるなどお手伝いの範囲は、事前のご相談でご確認ください。
    </p>

    <!-- ジャンルの目次 -->
    <nav aria-label="ジャンル" class="mb-14">
      <ul class="flex flex-wrap justify-center gap-3">
        {groups.map((g) => (
          <li><a href={`#${genreId(g.genre)}`} class="chip-link" data-genre-link>{g.genre}<span class="chip-count">{g.cases.length}</span></a></li>
        ))}
      </ul>
    </nav>

    {groups.map((g) => (
      <section id={genreId(g.genre)} class="mb-16 scroll-mt-24" data-genre-section>
        <SectionTitle class="is-left mb-8">{g.genre}</SectionTitle>
        <ul class="grid sm:grid-cols-2 gap-6">
          {g.cases.map((c) => (
            <li><CaseCard id={c.id} title={c.data.title} genre={c.data.genre} summary={c.data.summary} /></li>
          ))}
        </ul>
      </section>
    ))}

    <section class="cta-panel" data-testid="cases-cta">
      <h2 class="font-heading text-xl font-bold text-ink-strong mb-3">ご自身の場合は、どうでしょう</h2>
      <p class="leading-loose [word-break:auto-phrase] mb-6">ここにない場面でも、まずはお話しください。行き先や日時がまだ決まっていなくても大丈夫です。</p>
      <a href="/contact#contact-form" class="btn-solid">相談フォームへ</a>
      <p class="mt-5 text-[1rem]"><a href="/service#prices" class="text-accent underline">料金を見る</a>　<a href="/service#flow" class="text-accent underline">ご利用の流れを見る</a></p>
    </section>
  </div>
</Layout>
