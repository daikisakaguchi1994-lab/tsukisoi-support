---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { SITE, isTelConfigured, isTelSample, isFormOpen } from '../config';
import { generateLineQrSvg, isLineUrlConfigured } from '../utils/qr';
import { getCases } from '../utils/cases';

const qrSvg = await generateLineQrSvg(SITE.LINE_URL);
const lineConfigured = isLineUrlConfigured(SITE.LINE_URL);
const telConfigured = isTelConfigured(SITE.TEL);
const telSample = isTelSample(SITE.TEL);
// 受付前は、送信キーがあっても受付中に見せない。受付開始は PUBLIC_FORM_OPEN=1（利用者の判断）で切り替える
const formKey = import.meta.env.PUBLIC_FORM_KEY || '';
const formReady = isFormOpen(formKey, import.meta.env.PUBLIC_FORM_OPEN);
// ご利用例（/cases/<スラッグ>）の「この内容で相談する」から来たとき、種類と冒頭の一文を自動で入れる
const caseMap = Object.fromEntries((await getCases()).map((c) => [c.id, { title: c.data.title, kind: c.data.kind }]));
const kinds = ['通院・お買い物などの付き添い', '旅行の付き添い', 'その他・まだ決まっていない'];
// 返信方法に LINE は出さない。LINE の識別子の受け取り方・返信手順が決まるまで（確定後も、その手順を決めてから足す）
const methods = ['電話', 'メール'];
---
<Layout title="相談フォーム" description={`${SITE.SERVICE_NAME}へのお問い合わせ。相談フォームからお気軽にご連絡ください。`} crumbs={[{ label: '相談フォーム' }]}>
  <div class="max-w-3xl mx-auto px-4 py-14 md:py-20">
    <h1 class="sr-only">相談フォーム</h1>

    <p class="leading-loose mb-4 [word-break:auto-phrase]">
      {formReady
        ? 'ご相談は、下の相談フォームからお送りください。お付き添い中などで、すぐにお返事できないことがあります。内容を確認のうえ、折り返しご連絡します。'
        : '相談フォームは公開準備中です。受付を始めるまで、しばらくお待ちください。'}
    </p>
    {formReady && <p class="mb-12"><a href="#contact-form" class="btn-outline">相談フォームへ</a></p>}

    <!-- Tel -->
    <SectionTitle class="is-left mb-6">お電話での問い合わせ</SectionTitle>
    <div class="mb-12">
      {telConfigured ? (
        <a href={`tel:${SITE.TEL}`} class="btn-phone">{SITE.TEL}</a>
      ) : telSample ? (
        <p class="btn-phone">{SITE.TEL}</p>
      ) : (
        <p class="text-[1rem] leading-loose">電話相談は準備中です。公開までしばらくお待ちください。</p>
      )}
      {telSample && <p class="text-[1rem] text-ink-muted mt-2">（サンプル。実際の番号は準備中です）</p>}
      {(telConfigured || telSample) && SITE.TEL_HOURS && <p class="text-[1rem] text-ink-muted mt-2">{SITE.TEL_HOURS}</p>}
    </div>

    <!-- LINE -->
    <SectionTitle class="is-left mb-6">LINEでの問い合わせ</SectionTitle>
    <div class="mb-12">
      {lineConfigured ? (
        <>
          <a
            href={SITE.LINE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="md:hidden inline-flex items-center justify-center bg-line text-white font-bold px-8 min-h-[44px] rounded-full tracking-widest hover:opacity-90"
          >
            LINEで友だち追加
          </a>
          <div class="hidden md:flex items-center gap-6">
            <div class="inline-block border border-rule p-2" set:html={qrSvg} />
            <p class="text-[1rem] text-ink-muted">スマートフォンでQRコードを読み取ってください。</p>
          </div>
        </>
      ) : (
        <p class="text-[1rem] leading-loose">LINE公式アカウントは準備中です。</p>
      )}
    </div>

    <!-- Form -->
    <SectionTitle class="is-left mb-8">相談フォーム</SectionTitle>
    {!formReady && (
      <div data-testid="form-pending" class="mb-8 flex gap-4 bg-[#F3E4E2] border-l-4 border-[#9A3B32] px-5 py-4 text-[1rem] leading-loose">
        <p class="[word-break:auto-phrase]">相談フォームは公開準備中です。受付を始めるまで、しばらくお待ちください。</p>
      </div>
    )}
    <p id="case-from" data-testid="case-from" class="mb-6 border-l-4 border-deep bg-base-alt px-5 py-3 leading-loose" hidden></p>
    <script type="application/json" id="case-map" set:html={JSON.stringify(caseMap)} />
    <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
      {formReady && <input type="hidden" name="access_key" value={formKey} />}
      <input type="hidden" name="subject" value={`${SITE.SERVICE_NAME} お問い合わせ`} />
      <input type="hidden" name="redirect" value="/thanks" />

      <fieldset disabled={!formReady} class="space-y-7">
        <div>
          <label for="name" class="block font-bold text-[1rem] mb-2">お名前 <span class="text-red-700">*</span></label>
          <input type="text" id="name" name="name" autocomplete="name" aria-describedby="err-name" class="field md:max-w-md" placeholder="山田 太郎" />
          <p id="err-name" class="field-error" role="alert" hidden></p>
        </div>

        <fieldset>
          <legend class="font-bold text-[1rem] mb-2">ご希望の連絡方法 <span class="text-red-700">*</span></legend>
          <div class="space-y-1">
            {methods.map((method) => (
              <label class="flex items-center gap-3 cursor-pointer min-h-[44px]">
                <input type="radio" name="contact_method" value={method} class="w-5 h-5 accent-[#4A7042]" />
                <span class="text-[1rem]">{method}</span>
              </label>
            ))}
          </div>
          <p id="err-method" class="field-error" role="alert" hidden></p>
        </fieldset>

        <div>
          <label for="tel" class="block font-bold text-[1rem] mb-2">お電話番号 <span data-required-mark="phone" class="text-red-700" hidden>*</span></label>
          <input type="tel" id="tel" name="phone" autocomplete="tel" inputmode="tel" aria-describedby="hint-contact err-phone" class="field md:max-w-md" placeholder="090-1234-5678" />
          <p id="err-phone" class="field-error" role="alert" hidden></p>
        </div>

        <div>
          <label for="email" class="block font-bold text-[1rem] mb-2">メールアドレス <span data-required-mark="email" class="text-red-700" hidden>*</span></label>
          <input type="email" id="email" name="email" autocomplete="email" aria-describedby="hint-contact err-email" class="field md:max-w-md" placeholder="example@email.com" />
          <p id="err-email" class="field-error" role="alert" hidden></p>
          <p id="hint-contact" class="text-[1rem] text-ink-muted mt-2">ご希望の連絡方法に合わせて、電話番号またはメールアドレスをご入力ください。</p>
        </div>

        <fieldset>
          <legend class="font-bold text-[1rem] mb-2">お問い合わせの種類</legend>
          <div class="space-y-1">
            {kinds.map((k) => (
              <label class="flex items-center gap-3 cursor-pointer min-h-[44px]">
                <input type="radio" name="inquiry_kind" value={k} class="w-5 h-5 accent-[#4A7042]" />
                <span class="text-[1rem]">{k}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="message" class="block font-bold text-[1rem] mb-2">ご相談内容 <span class="text-red-700">*</span></label>
          <textarea id="message" name="message" rows={6} aria-describedby="hint-message err-message" class="field"
            placeholder="例：来月、病院への通院に付き添ってほしい。"></textarea>
          <p id="err-message" class="field-error" role="alert" hidden></p>
          <p id="hint-message" class="text-[1rem] text-ink-muted mt-2">わかる範囲で構いません。お体の状態など、詳しいことは後からお伺いします。</p>
        </div>

        <div>
          <label class="flex items-start gap-3 cursor-pointer min-h-[44px]">
            <input type="checkbox" name="privacy" aria-describedby="err-privacy" class="w-5 h-5 mt-0.5 accent-[#4A7042]" />
            <span class="text-[1rem]">
              <a href="/privacy" class="text-accent underline">個人情報の取り扱い</a>に同意する
              <span class="text-red-700">*</span>
            </span>
          </label>
          <p id="err-privacy" class="field-error" role="alert" hidden></p>
        </div>

        <button type="submit" class="btn-solid">相談内容を送信する</button>
      </fieldset>
    </form>

    <div class="mt-10 flex gap-4 bg-[#F3E4E2] border-l-4 border-[#9A3B32] px-5 py-4 text-[1rem] leading-loose">
      <p class="[word-break:auto-phrase]">内容を確認のうえ、2営業日以内にご連絡します。返信が届かないときは、迷惑メールの振り分けも見てみてください。</p>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const field = (name: string) => form?.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
  const checkedMethod = () => form?.querySelector<HTMLInputElement>('[name="contact_method"]:checked')?.value;

  // 返信方法に合わせて、連絡先の必須の印を切り替える
  const syncRequired = () => {
    const method = checkedMethod();
    for (const [key, name] of [['phone', '電話'], ['email', 'メール']] as const) {
      const mark = form?.querySelector<HTMLElement>(`[data-required-mark="${key}"]`);
      if (mark) mark.hidden = method !== name;
    }
  };
  form?.addEventListener('change', syncRequired);
  syncRequired();

  // ご利用例から来たとき: 種類を選び、冒頭の一文を入れる（すでに書いてあれば上書きしない）
  const slug = new URLSearchParams(location.search).get('case');
  const mapText = document.getElementById('case-map')?.textContent;
  const caseData = mapText ? (JSON.parse(mapText) as Record<string, { title: string; kind: string }>) : {};
  // __proto__ など継承されたプロパティを拾わないよう、自分の持つキーだけを許可する
  const picked = slug && Object.hasOwn(caseData, slug) ? caseData[slug] : undefined;
  if (picked && form) {
    const radio = [...form.querySelectorAll<HTMLInputElement>('[name="inquiry_kind"]')].find((r) => r.value === picked.kind);
    if (radio) radio.checked = true;
    const msg = field('message');
    if (msg && !msg.value.trim()) msg.value = `【ご利用例「${picked.title}」について】
`;
    const note = document.getElementById('case-from');
    if (note) {
      note.textContent = `ご利用例「${picked.title}」からのご相談です。内容は、わかる範囲でご記入ください。`;
      note.hidden = false;
    }
  }

  const show = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
  };

  form?.addEventListener('submit', (e) => {
    const method = checkedMethod();
    const empty = (name: string) => !field(name)?.value.trim();
    const errors: { id: string; text: string; target: HTMLElement | null | undefined }[] = [];

    if (empty('name')) errors.push({ id: 'err-name', text: 'お名前を入力してください。', target: field('name') });
    if (!method) errors.push({ id: 'err-method', text: 'ご希望の連絡方法を選んでください。', target: field('contact_method') });
    if (method === '電話' && empty('phone')) errors.push({ id: 'err-phone', text: '電話でのご連絡をご希望の場合は、お電話番号を入力してください。', target: field('phone') });
    if (method === 'メール' && empty('email')) errors.push({ id: 'err-email', text: 'メールでのご連絡をご希望の場合は、メールアドレスを入力してください。', target: field('email') });
    if (field('email') && !empty('email') && !(field('email') as HTMLInputElement).validity.valid) errors.push({ id: 'err-email', text: 'メールアドレスの形式をご確認ください。', target: field('email') });
    if (empty('message')) errors.push({ id: 'err-message', text: 'ご相談内容を入力してください。', target: field('message') });
    if (!(field('privacy') as HTMLInputElement | null)?.checked) errors.push({ id: 'err-privacy', text: '個人情報の取り扱いに同意してください。', target: field('privacy') });

    for (const id of ['err-name', 'err-method', 'err-phone', 'err-email', 'err-message', 'err-privacy']) show(id, '');
    if (errors.length > 0) {
      // 入力内容は消さない。該当欄の近くにメッセージを出し、最初の欄へ移す
      e.preventDefault();
      for (const err of errors) show(err.id, err.text);
      errors[0].target?.focus();
    }
  });
</script>
