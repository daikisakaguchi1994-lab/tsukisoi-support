---
import { SITE } from '../config';
---

<!-- 写真素材が決まるまでは配色グラデーションで代替。差し替え時は背景の div に <img> を入れる -->
<section class="relative w-full min-h-[100dvh] overflow-hidden flex items-center justify-center text-center text-white bg-gradient-to-br from-accent via-[#4f7a47] to-ink-strong">
  <div class="absolute inset-0 opacity-20" aria-hidden="true" style="background: radial-gradient(circle at 20% 20%, #fff 0, transparent 40%), radial-gradient(circle at 80% 80%, #fff 0, transparent 35%);"></div>

  <div class="relative z-10 px-6 pt-16">
    <p class="font-heading text-sm md:text-base tracking-[0.3em] mb-4 opacity-90">ACCOMPANY SUPPORT</p>
    <h1 class="font-heading text-4xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6 text-white tracking-wide">
      {SITE.TAGLINE}
    </h1>
    <p class="font-heading text-base md:text-xl font-semibold leading-relaxed mb-10 text-white">
      — お出かけに、安心の付き添いを —
    </p>
    <div class="font-heading text-sm md:text-lg leading-loose opacity-95">
      <p>通院も、お買い物も、旅行も。</p>
      <p>ひとりでは不安なお出かけに、</p>
      <p>{SITE.SERVICE_NAME}が寄り添います。</p>
    </div>
  </div>

  <a href="#concept" class="absolute bottom-24 md:bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center text-xs tracking-[0.3em] text-white/80 hover:text-white" aria-label="下へスクロール">
    Scroll
    <span class="block w-px h-10 bg-white/60 mt-2 animate-pulse"></span>
  </a>
</section>
