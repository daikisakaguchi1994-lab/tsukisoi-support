---
// public/images/hero/ 内の画像をビルド時に自動検出し、配列として読み込む。
// 画像を追加/削除するだけでクロスフェードのローテーション枚数が自動的に変わる。
import fs from 'node:fs';
import path from 'node:path';

const heroDir = path.join(process.cwd(), 'public', 'images', 'hero');
const heroImages = fs.existsSync(heroDir)
  ? fs
      .readdirSync(heroDir)
      .filter((file) => /\.(jpe?g|png|webp)$/i.test(file))
      .sort((a, b) => a.localeCompare(b, 'ja'))
      .map((file) => `/images/hero/${file}`)
  : [];
---

<section class="relative w-full min-h-[100dvh] overflow-hidden bg-ink-strong">
  <div class="absolute inset-0" aria-hidden="true">
    {heroImages.map((src, i) => (
      <img
        src={src}
        alt=""
        class:list={['hero-slide absolute inset-0 h-full w-full object-cover', { 'is-active': i === 0 }]}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'low'}
        decoding={i === 0 ? 'sync' : 'async'}
      />
    ))}
  </div>

  <!-- 可読性確保のための暗幕グラデーション: モバイルは下から上、デスクトップは左から右 -->
  <div
    class="absolute inset-0 md:hidden"
    style="background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.4) 30%, transparent 55%);"
  ></div>
  <div
    class="absolute inset-0 hidden md:block"
    style="background: linear-gradient(105deg, rgba(0,0,0,0.62) 0%, transparent 75%);"
  ></div>

  <!-- モバイル: 下部・左寄せ -->
  <div class="absolute inset-x-0 bottom-0 z-10 flex md:hidden flex-col items-start px-6 pb-24 text-left text-white">
    <h1 class="font-heading text-2xl font-bold leading-snug mb-3 text-white tracking-[0.5px]">
      その願い、<br />あきらめない。
    </h1>
    <p class="font-heading text-base font-semibold leading-relaxed text-white [text-shadow:0_1px_4px_rgba(0,0,0,0.6)]">
      医療のプロが、あなたの外出に寄り添います。<br />
      行きたい場所へ、会いたい人のもとへ、もう一度。
    </p>
  </div>

  <!-- デスクトップ: 左側・垂直中央 -->
  <div class="absolute inset-y-0 left-0 z-10 hidden md:flex flex-col items-start justify-center max-w-[58%] px-12 pt-20 lg:px-20 text-left text-white">
    <h1 class="font-heading text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6 text-white tracking-[0.5px]">
      その願い、<br />あきらめない。
    </h1>
    <p class="font-heading text-lg lg:text-xl font-semibold leading-relaxed text-white [text-shadow:0_1px_4px_rgba(0,0,0,0.5)]">
      医療のプロが、あなたの外出に寄り添います。<br />
      行きたい場所へ、会いたい人のもとへ、もう一度。
    </p>
  </div>
</section>

<style>
  .hero-slide {
    opacity: 0;
    transition: opacity 1.5s ease;
    animation: hero-kenburns 7.5s ease-out forwards;
    will-change: opacity, transform;
  }
  .hero-slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  @keyframes hero-kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (slides.length > 1 && !prefersReducedMotion) {
    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[current].classList.remove('is-active');
      slides[next].classList.add('is-active');
      // Ken Burnsアニメーションを再スタートさせるためのリフロー
      slides[next].style.animation = 'none';
      void slides[next].offsetHeight;
      slides[next].style.animation = '';
      current = next;
    }, 6000);
  }
</script>
