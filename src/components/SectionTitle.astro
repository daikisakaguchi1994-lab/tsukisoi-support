---
interface Props {
  tag?: 'h2' | 'h3';
  variant?: 'line' | 'bar';
  class?: string;
}

const { tag: Tag = 'h2', variant = 'line', class: className = '' } = Astro.props;
---
<Tag class:list={[
  variant === 'bar' ? 'heading-bar' : 'title-line',
  'font-heading text-xl md:text-2xl',
  className,
]}>
  <slot />
</Tag>
