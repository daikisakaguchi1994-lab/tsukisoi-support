---
import { SITE, isConfigured } from '../config';
---
<div class="bg-ink-strong text-white">
  <div class="max-w-6xl mx-auto px-4 h-7 flex items-center justify-end gap-4">
    {isConfigured(SITE.INSTAGRAM_URL) && (
      <a href={SITE.INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="opacity-90 hover:opacity-100">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
      </a>
    )}
    <a href="/contact" aria-label="お問い合わせ" class="opacity-90 hover:opacity-100">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M3 5h18a1 1 0 011 1v.4l-10 6.3L2 6.4V6a1 1 0 011-1zm-1 3.7l9.5 6a1 1 0 001 0L22 8.7V18a1 1 0 01-1 1H3a1 1 0 01-1-1V8.7z" /></svg>
    </a>
  </div>
</div>
