---
import { SITE, NAV_ITEMS } from '../config';
---
<header class="fixed top-0 left-0 right-0 z-50 bg-base/90 backdrop-blur-sm border-b border-base-alt">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="font-heading text-xl font-bold tracking-widest text-ink-strong">
      {SITE.SERVICE_NAME}
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-7" aria-label="メインナビゲーション">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class="group text-center leading-tight hover:text-accent transition-colors">
          <span class="block text-sm text-ink group-hover:text-accent">{item.label}</span>
          <span class="block text-[10px] tracking-wider text-ink/40">{item.en}</span>
        </a>
      ))}
    </nav>

    <!-- Mobile Hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 min-w-[44px] min-h-[44px] flex items-center justify-center"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden bg-base border-t border-base-alt"
    aria-label="モバイルナビゲーション"
  >
    <div class="px-4 py-6 space-y-4">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class="block text-lg text-ink hover:text-accent transition-colors">
          {item.label}
          <span class="ml-2 text-xs tracking-wider text-ink/40">{item.en}</span>
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
  // アンカーリンクを押したらメニューを閉じる
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
