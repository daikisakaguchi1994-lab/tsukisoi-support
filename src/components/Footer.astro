---
import { SITE, NAV_ITEMS, isConfigured, isTelConfigured, isTelSample } from '../config';

const year = new Date().getFullYear();
---
<footer class="bg-ink-strong text-base py-16">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-10 mb-12">
      <div>
        <p class="font-heading text-xl font-bold tracking-widest mb-2">{SITE.SERVICE_NAME}</p>
        <p class="text-sm opacity-70">{SITE.TAGLINE}</p>
      </div>
      <div class="text-sm space-y-1 opacity-80">
        <p>{SITE.COMPANY_NAME}</p>
        {isConfigured(SITE.ADDRESS) && <p>{SITE.ADDRESS}</p>}
        {isTelConfigured(SITE.TEL)
          ? <p>TEL: <a href={`tel:${SITE.TEL}`} class="hover:underline">{SITE.TEL}</a></p>
          : isTelSample(SITE.TEL)
            ? <p>TEL: {SITE.TEL}（サンプル）</p>
            : <p>電話相談は準備中です</p>}
        {isConfigured(SITE.EMAIL) && (
          <p>Mail: <a href={`mailto:${SITE.EMAIL}`} class="hover:underline">{SITE.EMAIL}</a></p>
        )}
        <p><a href="/privacy" class="hover:underline">個人情報の取り扱い</a></p>
        {isConfigured(SITE.INSTAGRAM_URL) && (
          <p><a href={SITE.INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="hover:underline">Instagram</a></p>
        )}
      </div>
      <nav aria-label="フッターナビゲーション">
        <ul class="space-y-2">
          {NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} class="text-sm opacity-80 hover:opacity-100 transition-opacity">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="border-t border-white/10 pt-6 text-center text-xs opacity-50">
      <p>&copy; {year} {SITE.COMPANY_NAME}</p>
    </div>
  </div>
</footer>
