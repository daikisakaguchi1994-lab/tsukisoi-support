---
import { SITE, NAV_ITEMS, isConfigured, isTelConfigured, isTelSample } from '../config';

const year = new Date().getFullYear();
---
<footer class="bg-accent text-white">
  <div class="max-w-6xl mx-auto px-4 py-10 text-center">
    <div class="flex justify-center gap-5 mb-5">
      {isConfigured(SITE.INSTAGRAM_URL) && (
        <a href={SITE.INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
        </a>
      )}
      <a href="/contact" aria-label="お問い合わせ">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M3 5h18a1 1 0 011 1v.4l-10 6.3L2 6.4V6a1 1 0 011-1zm-1 3.7l9.5 6a1 1 0 001 0L22 8.7V18a1 1 0 01-1 1H3a1 1 0 01-1-1V8.7z" /></svg>
      </a>
    </div>

    <nav aria-label="フッターナビゲーション" class="mb-6">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-0 text-base">
        {NAV_ITEMS.map((item) => (
          <li><a href={item.href} class="inline-flex items-center min-h-[44px] hover:underline">{item.label}</a></li>
        ))}
        <li><a href="/privacy" class="inline-flex items-center min-h-[44px] hover:underline">個人情報の取り扱い</a></li>
      </ul>
    </nav>

    <div class="text-base space-y-1">
      <p class="font-bold tracking-widest">{SITE.COMPANY_NAME}</p>
      {isConfigured(SITE.ADDRESS) && <p>{SITE.ADDRESS}</p>}
      {isTelConfigured(SITE.TEL)
        ? <p>TEL: <a href={`tel:${SITE.TEL}`} class="hover:underline">{SITE.TEL}</a></p>
        : isTelSample(SITE.TEL)
          ? <p>TEL: {SITE.TEL}（サンプル）</p>
          : <p>電話相談は準備中です</p>}
      {isConfigured(SITE.EMAIL) && (
        <p>Mail: <a href={`mailto:${SITE.EMAIL}`} class="hover:underline">{SITE.EMAIL}</a></p>
      )}
    </div>
    <p class="mt-6 text-sm">&copy; {year} {SITE.COMPANY_NAME}</p>
  </div>
</footer>
