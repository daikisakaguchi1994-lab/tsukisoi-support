  {name === 'steps' && (<>
    <path d="M10 78h18V64h18V50h18V36h22" /><path d="M10 78h76" /><path d="M20 30l8 8 16-18" />
  </>)}
  {name === 'family' && (<>
    <path d="M12 46L48 16l36 30" /><path d="M20 40v38h56V40" /><path d="M48 70c-10-7-14-12-14-17a7 7 0 0114-3 7 7 0 0114 3c0 5-4 10-14 17z" />
  </>)}
  {name === 'trip' && (<>
    <rect x="16" y="32" width="64" height="46" rx="5" /><path d="M36 32v-8a4 4 0 014-4h16a4 4 0 014 4v8" /><path d="M16 52h64M44 52v6h8v-6" />
