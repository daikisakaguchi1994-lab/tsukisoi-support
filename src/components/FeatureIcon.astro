  {name === 'pace' && (<>
    <circle cx="36" cy="22" r="7" /><path d="M36 30v26M36 40l-12 10M36 40l12 4M36 56l-10 22M36 56l12 22" /><path d="M62 40v38M56 40h12" /><path d="M72 66c4 0 10 2 12 10" />
