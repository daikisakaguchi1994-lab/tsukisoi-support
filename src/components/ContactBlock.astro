---
import { SITE, isTelConfigured, isTelSample } from '../config';
import { isLineUrlConfigured } from '../utils/qr';

const lineConfigured = isLineUrlConfigured(SITE.LINE_URL);
const telConfigured = isTelConfigured(SITE.TEL);
const telSample = isTelSample(SITE.TEL);
---
<section id="contact-block" class="pb-16">
  <div class="max-w-3xl mx-auto px-4">
    <hr class="w-24 mx-auto border-rule mb-12" />
    <div class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-10 items-center">
      <div class="text-center">
        {telConfigured ? (
          <a href={`tel:${SITE.TEL}`} class="btn-phone">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.25 11.4 11.4 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.6a1 1 0 01-.25 1z" /></svg>
            {SITE.TEL}
          </a>
        ) : telSample ? (
          <p class="btn-phone">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.25 11.4 11.4 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.6a1 1 0 01-.25 1z" /></svg>
            {SITE.TEL}
          </p>
        ) : (
          <p class="text-[1rem]">電話相談は準備中です</p>
        )}
        {telSample && <p class="text-sm text-ink-muted mt-2">（サンプル。実際の番号は準備中です）</p>}
        {telSample && <p class="text-sm text-ink-muted">{SITE.TEL_HOURS}</p>}
        {telConfigured && SITE.TEL_HOURS && <p class="text-sm text-ink-muted mt-2">{SITE.TEL_HOURS}</p>}
      </div>
      <p class="text-base leading-loose [word-break:auto-phrase]">
        お付き添い中などで、すぐにお電話に出られないことがあります。つながらないときは、お問い合わせフォームからご連絡ください。内容を確認のうえ、折り返しご連絡します。
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-4 mt-10">
      {lineConfigured && (
        <a href={SITE.LINE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-line text-white font-bold px-8 min-h-[44px] rounded-full tracking-widest hover:opacity-90">
          LINEで友だち追加
        </a>
      )}
      <a href="/contact" class="btn-solid">お問い合わせフォーム</a>
    </div>
  </div>
</section>
